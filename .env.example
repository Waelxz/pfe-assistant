# Optional environment overrides (you can configure your API key directly in the app UI instead)

# LLM provider: "gemini" (recommended) or "openai_compatible"
LLM_PROVIDER=gemini

# Google Gemini API key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional OpenAI-compatible settings (OpenRouter, OpenAI, Groq, Ollama)
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=gemini-3.5-flash
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite, gemini-3.8-flash

# Optional custom data directory (defaults to ./data in repo checkout or ~/.pfe-assistant when installed)
# PFE_DATA_DIR=
